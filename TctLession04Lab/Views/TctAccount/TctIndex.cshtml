@{
    ViewData["Title"] = "Danh sach tai khoan";
    var tctAccounts = ViewBag.TctAccounts;
}
<div class="row" >
    @foreach (TctAccount item in tctAccounts)
    {
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="img">
                        <img src="@item.Avatar" alt="@item.Name" class="w-100" />
    
                    </div>
                    <div class="">
                        <h3>@item.Name</h3>
                        <q>@item.Bio</q>
                        <a asp-asp-route="TctProfile" asp-route-id="@item.Id" class="btn btn-success btn-block">Profile</a>
                    </div>
                </div>
            </div>
        </div>
    }
    
</div>